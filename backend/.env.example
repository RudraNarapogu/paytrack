# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=3000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Replace 'password' with your PostgreSQL password
DATABASE_URL=postgresql://postgres:password@localhost:5432/paytrack_dev

# =============================================================================
# JWT SECRETS (REQUIRED)
# =============================================================================
# Generate random strings (min 32 characters)
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long-replace-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-characters-long-replace-this

# JWT Expiry
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# In development, allow all origins
CORS_ORIGIN=*

# In production, specify allowed origins (comma-separated)
# CORS_ORIGIN=https://paytrack.app,https://www.paytrack.app

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# SMS/OTP SERVICE (OPTIONAL - For Production)
# =============================================================================
# In development, OTP will be logged to console
# Uncomment and configure ONE of the following for production:

# Option 1: Twilio
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# Option 2: Firebase Auth
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_PRIVATE_KEY=your-private-key
# FIREBASE_CLIENT_EMAIL=your-client-email

# Option 3: MSG91 (India)
# MSG91_AUTH_KEY=your_auth_key
# MSG91_SENDER_ID=your_sender_id

# =============================================================================
# PUSH NOTIFICATIONS (OPTIONAL - For Production)
# =============================================================================
# FCM_SERVER_KEY=your_fcm_server_key

# =============================================================================
# PAYMENT GATEWAY (OPTIONAL - For Production)
# =============================================================================
# Razorpay
# RAZORPAY_KEY_ID=your_key_id
# RAZORPAY_KEY_SECRET=your_key_secret

# =============================================================================
# LOGGING (OPTIONAL)
# =============================================================================
# LOG_LEVEL=info
# SENTRY_DSN=your_sentry_dsn
